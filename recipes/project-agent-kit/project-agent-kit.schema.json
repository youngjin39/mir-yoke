{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youngjin39/mir-yoke/blob/main/recipes/project-agent-kit/project-agent-kit.schema.json",
  "title": "Project Agent Kit Target Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_slug", "intent", "provider", "common_harness", "foundation", "generation", "commands"],
  "properties": {
    "schema_version": {"const": 2},
    "project_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "context_probe", "purpose_sha256", "rendered_prompt_sha256"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "context_probe": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "purpose_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rendered_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": {"const": "https://github.com/youngjin39/mir-yoke"},
        "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
      }
    },
    "common_harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "commands"],
      "properties": {
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config", "database", "handoff", "mir_wrapper", "memory_sync_wrapper", "memory_sync_hook"],
          "properties": {
            "config": {"const": "harness_a.toml"},
            "database": {"const": ".mir/memory.db"},
            "handoff": {"const": "tasks/handoffs/session-handoff-LATEST.md"},
            "mir_wrapper": {"const": "scripts/mir.sh"},
            "memory_sync_wrapper": {"const": "scripts/memory-sync.sh"},
            "memory_sync_hook": {"const": ".githooks/pre-commit"}
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory_init", "memory_sync", "memory_doctor", "context_pull"],
          "properties": {
            "memory_init": {"const": ["scripts/mir.sh", "migrate", "up", "--db", ".mir/memory.db"]},
            "memory_sync": {"const": ["scripts/memory-sync.sh"]},
            "memory_doctor": {"const": ["scripts/mir.sh", "memory", "doctor", "--project-root", ".", "--json"]},
            "context_pull": {
              "type": "array",
              "prefixItems": [
                {"const": "scripts/mir.sh"},
                {"const": "context"},
                {"const": "pull"},
                {"type": "string", "minLength": 3},
                {"const": "--db"},
                {"const": ".mir/memory.db"},
                {"const": "--project-root"},
                {"const": "."}
              ],
              "items": false,
              "minItems": 8,
              "maxItems": 8
            }
          }
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "lockfile", "compile_targets", "smoke_tests"],
      "properties": {
        "manifest": {"$ref": "#/$defs/relativePath"},
        "lockfile": {"$ref": "#/$defs/relativePath"},
        "compile_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "smoke_tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "generated"],
      "properties": {
        "canonical": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "generated": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_parity", "lint", "build", "test"],
      "properties": {
        "generated_parity": {
          "oneOf": [
            {"const": ["python3", "scripts/generate_agent_derivatives.py", "--check"]},
            {"const": ["python", "scripts/generate_agent_derivatives.py", "--check"]},
            {"const": ["uv", "run", "python", "scripts/generate_agent_derivatives.py", "--check"]}
          ]
        },
        "lint": {"const": ["scripts/verify.sh", "lint"]},
        "build": {"const": ["scripts/verify.sh", "build"]},
        "test": {"const": ["scripts/verify.sh", "test"]}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    }
  }
}
