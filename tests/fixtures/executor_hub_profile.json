  "oracle_source": "from __future__ import annotations\nimport argparse\nimport hashlib\nimport importlib.metadata\nimport json\nimport pathlib\nfrom tools.mir_executor.local_hooks import local_config\n\"\"\"DispatchBrief contract for execution-lane handoff and durable resume.\"\"\"\n\n\nfrom pydantic import BaseModel, ConfigDict, Field, model_validator\n\n\nclass DispatchBriefSourceRefs(BaseModel):\n    \"\"\"Source references used to derive a dispatch brief.\"\"\"\n\n    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n\n    task_spec: str = Field(min_length=1)\n    plan: str = Field(default=\"tasks/plan.md\")\n    phase: str = Field(min_length=1)\n\n\nclass DispatchBrief(BaseModel):\n    \"\"\"Execution-ready handoff artifact for one target agent and one slice.\"\"\"\n\n    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n\n    version: int = Field(default=1)\n    task_id: str = Field(min_length=1)\n    phase_id: str | None = None\n    slice_id: str = Field(min_length=1)\n    target_agent: str = Field(min_length=1)\n    user_intent: str = Field(min_length=1)\n    expanded_goal: str = Field(min_length=1)\n    owned_scope: tuple[str, ...] = Field(min_length=1)\n    out_of_scope: tuple[str, ...] = ()\n    verification_commands: tuple[str, ...] = Field(min_length=1)\n    stop_conditions: tuple[str, ...] = Field(min_length=1)\n    handoff_refs: tuple[str, ...] = ()\n    tdd_change_refs: tuple[str, ...] = ()\n    resume_state_ref: str = Field(min_length=1)\n    source_refs: DispatchBriefSourceRefs\n\n    @model_validator(mode=\"after\")\n    def _validate_contract(self) -> DispatchBrief:\n        if self.version != 1:\n            raise ValueError(\"DispatchBrief.version must be 1\")\n        expected_resume_ref = f\"tasks/dispatch/{self.task_id}/{self.slice_id}.json\"\n        if self.resume_state_ref != expected_resume_ref:\n            raise ValueError(\n                \"DispatchBrief.resume_state_ref must match \"\n                f\"{expected_resume_ref!r}\"\n            )\n        if self.source_refs.plan != \"tasks/plan.md\":\n            raise ValueError(\"DispatchBrief.source_refs.plan must be 'tasks/plan.md'\")\n        return self\n\ndef load_dispatch_brief(path: pathlib.Path) -> DispatchBrief:\n    \"\"\"Load and validate a persisted DispatchBrief JSON file.\"\"\"\n    payload: dict[str, Any] = json.loads(path.read_text(encoding=\"utf-8\"))\n    return DispatchBrief(**payload)\ndef validate_brief(brief: pathlib.Path | str, repo_root: pathlib.Path):\n    \"\"\"Keep the typed DispatchBrief schema and the delegated-input bound (GAP-035).\n\n    An over-budget input is refused explicitly rather than truncated into a prompt\n    the delegate believes is complete.\n    \"\"\"\n    if isinstance(brief, pathlib.Path):\n        from mir.core.conductor.dispatch_brief import load_dispatch_brief  # noqa: PLC0415\n\n        loaded = load_dispatch_brief(brief)\n        _require_input_bound(loaded.expanded_goal, repo_root)\n        return loaded\n    _require_input_bound(brief, repo_root)\n    return None\n\ndef _require_input_bound(text: str, repo_root: pathlib.Path) -> None:\n    limit = local_config(repo_root)[\"input_limit_bytes\"]\n    size = len(text.encode(\"utf-8\"))\n    if size > limit:\n        raise ValueError(\n            f\"delegated input exceeds {limit} bytes ({size}); refusing rather than truncating\"\n        )\n\ndef job_identity(\n    args: argparse.Namespace, repo_root: pathlib.Path, prompt: str, model: str | None\n) -> str:\n    \"\"\"Execution identity evidence for one delegated job (owner decision 2026-08-04,\n    GAP-036): the exact instruction hash, the dispatching package identity, the\n    tool-schema identity of the Codex surface, and the advisory model alias per\n    ADR-49 (never a hard-pinned native version). The ceiling field records explicitly\n    that v1 sets no hard token or cost limit -- usage alerting is the only spend surface.\n    \"\"\"\n    if model is None:\n        model = \"codex-config-default\" if args.dispatch else \"policy-or-config-default\"\n    try:\n        package_version = importlib.metadata.version(\"mir-agent-hub\")\n    except importlib.metadata.PackageNotFoundError:\n        package_version = \"unknown\"\n    return json.dumps(\n        {\n            \"instruction_sha256\": hashlib.sha256(prompt.encode(\"utf-8\")).hexdigest(),\n            \"package\": f\"mir-agent-hub {package_version}\",\n            \"tool_schema\": \"codex-mcp:tools/codex\",\n            \"model_alias\": model,\n            \"ceiling\": \"none-v1-usage-alerting-only\",\n        },\n        sort_keys=True,\n    )\nimport sys\nimport types\n_loader = types.ModuleType(\"mir.core.conductor.dispatch_brief\")\n_loader.load_dispatch_brief = load_dispatch_brief\nsys.modules[_loader.__name__] = _loader\n",
