{
  "schema_version": 1,
  "roles": {
    "control-plane": {
      "responsibilities": ["classify-task", "select-lane", "verify-outcome"],
      "runtime_adapters": {
        "claude": {"delegated_tool": "Agent"},
        "codex": {"delegated_tool": "spawn_agent"}
      }
    },
    "executor": {
      "responsibilities": ["implement-approved-scope", "run-focused-checks"],
      "runtime_adapters": {
        "claude": {"delegated_tool": "Agent"},
        "codex": {"delegated_tool": "spawn_agent"}
      }
    },
    "reviewer": {
      "responsibilities": ["review-changed-scope", "report-evidence"],
      "runtime_adapters": {
        "claude": {"delegated_tool": "Agent"},
        "codex": {"delegated_tool": "spawn_agent"}
      }
    }
  }
}
