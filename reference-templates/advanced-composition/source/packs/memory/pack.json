{
  "$schema": "../../config/capability-pack.schema.json",
  "schema_version": 1,
  "id": "memory",
  "version": "0.9.0",
  "product_role": "pack",
  "support_level": "preview",
  "execution_state": "opt-in",
  "description": "Local SQLite and FTS context storage with explicit rebuildable state and incremental-ingest guidance.",
  "dependencies": [],
  "source_paths": [
    "src/mir/cli/memory.py",
    "src/mir/cli/migrate.py",
    "src/mir/core/engine/memory/**/*.py",
    "src/mir/core/engine/memory/migrations/*.sql",
    "scripts/post_edit_memory_sync.py"
  ],
  "adoption_assets": [
    {"source": "packs/memory/payload/MEMORY.md", "target": "docs/harness/memory.md"},
    {"source": "packs/memory/payload/config/memory.toml", "target": "config/memory.toml"}
  ],
  "compatibility": {
    "platforms": ["macos", "linux", "windows-python"],
    "runtimes": ["python-3.12", "sqlite-fts5"]
  },
  "verification": ["uv run pytest -q tests/test_memory_doctor.py tests/test_memory_sync.py"],
  "local_state_paths": [".mir/memory.db", ".mir/memory.db-shm", ".mir/memory.db-wal"]
}
