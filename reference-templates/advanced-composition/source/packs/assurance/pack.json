{
  "$schema": "../../config/capability-pack.schema.json",
  "schema_version": 1,
  "id": "assurance",
  "version": "0.9.0",
  "product_role": "pack",
  "support_level": "preview",
  "execution_state": "opt-in",
  "description": "Risk-selected specification lattice, traceability, release evidence, and independent verification guidance.",
  "dependencies": [],
  "source_paths": [
    "src/mir/cli/bootstrap.py",
    "plugins/mir-core/skills/spec-architect/SKILL.md",
    "plugins/mir-core/skills/spec-architect/references/*.md",
    "spec/**/*.yaml",
    "spec/STATE.md",
    "scripts/verify_release_readiness.py"
  ],
  "adoption_assets": [
    {"source": "packs/assurance/payload/ASSURANCE.md", "target": "docs/harness/assurance.md"},
    {"source": "packs/assurance/payload/config/assurance.toml", "target": "config/assurance.toml"}
  ],
  "compatibility": {
    "platforms": ["any"],
    "runtimes": ["runtime-neutral-guidance"]
  },
  "verification": ["uv run pytest -q tests/test_spec_integrity.py tests/test_release_readiness.py"],
  "local_state_paths": []
}
