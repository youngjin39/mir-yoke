{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir-yoke/config/product-planes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "planes", "asset_axes", "execution_overrides"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "planes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "distribution", "project", "local"],
      "properties": {
        "source": {"$ref": "#/$defs/sourcePlane"},
        "distribution": {"$ref": "#/$defs/distributionPlane"},
        "project": {"$ref": "#/$defs/projectPlane"},
        "local": {"$ref": "#/$defs/localPlane"}
      }
    },
    "asset_axes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/axes"}
    },
    "execution_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "product_role", "support_level", "execution_state", "reason"],
        "properties": {
          "paths": {"$ref": "#/$defs/paths"},
          "product_role": {"$ref": "#/$defs/productRole"},
          "support_level": {"$ref": "#/$defs/supportLevel"},
          "execution_state": {"$ref": "#/$defs/executionState"},
          "reason": {"type": "string", "minLength": 12}
        }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "productRole": {"enum": ["core", "pack", "reference", "maintainer", "history"]},
    "supportLevel": {"enum": ["stable", "preview", "reference", "historical"]},
    "executionState": {"enum": ["inert", "opt-in", "active-maintainer"]},
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_role", "support_level", "execution_state"],
      "properties": {
        "product_role": {"$ref": "#/$defs/productRole"},
        "support_level": {"$ref": "#/$defs/supportLevel"},
        "execution_state": {"$ref": "#/$defs/executionState"}
      }
    },
    "sourcePlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "roots", "pack_manifest_glob"],
      "properties": {
        "owner": {"const": "mir-yoke-maintainer"},
        "roots": {"$ref": "#/$defs/paths"},
        "pack_manifest_glob": {"type": "string", "minLength": 1}
      }
    },
    "distributionPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_root", "tracked", "core_source", "sidecars"],
      "properties": {
        "output_root": {"type": "string", "minLength": 1},
        "tracked": {"const": false},
        "core_source": {"type": "string", "minLength": 1},
        "sidecars": {"$ref": "#/$defs/paths"}
      }
    },
    "projectPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_contract", "optional_policy", "ownership"],
      "properties": {
        "canonical_contract": {"const": "HARNESS.md"},
        "optional_policy": {"type": "string", "minLength": 1},
        "ownership": {"const": "consumer-repository"}
      }
    },
    "localPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "tracked", "state", "receipts", "provider_store"],
      "properties": {
        "root": {"const": ".mir"},
        "tracked": {"const": false},
        "state": {"type": "string", "minLength": 1},
        "receipts": {"type": "string", "minLength": 1},
        "provider_store": {"type": "string", "minLength": 1}
      }
    }
  }
}
