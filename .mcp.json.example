{
  "_comment": "Inactive legacy Codex MCP example: do not copy this removed endpoint into .mcp.json. Claude-to-Codex delegation uses the Codex plugin (`codex@openai-codex`, agent `codex:codex-rescue`); mir_executor uses `codex app-server`. The legacy entry is retained because this reference file has other dependants.",
  "mcpServers": {
    "codex": {
      "type": "stdio",
      "command": "codex",
      "args": ["mcp-server"],
      "env": {
        "CODEX_HOME": "${HOME}/.codex"
      }
    }
  }
}
