{
  "description": "GENERATED FILE: edit config/project-hooks.json and run scripts/generate_codex_derivatives.sh. Runtime-specific events omitted here: UserPromptSubmit and StopFailure remain Claude-only by policy.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/pre-tool-use.sh\"",
            "timeout": 30,
            "statusMessage": "Harness L2 PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/post-edit-check.sh\"",
            "timeout": 30,
            "statusMessage": "Harness post-edit check"
          },
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/post-edit-self-ingest.sh\"",
            "timeout": 30,
            "statusMessage": "ADR-05 self-ingest"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/pre-tool-use.sh\"",
            "timeout": 30,
            "statusMessage": "Harness L2 PermissionRequest"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/session-start.sh\"",
            "timeout": 30,
            "statusMessage": "Harness session-start"
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/compact-resume.sh\"",
            "timeout": 30,
            "statusMessage": "Harness compact resume context"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/session-end.sh\"",
            "timeout": 3,
            "statusMessage": "Harness canonical closeout"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/mir-stop.sh\"",
            "timeout": 30,
            "statusMessage": "Harness Stop audit"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/pre-compact.sh\"",
            "timeout": 60,
            "statusMessage": "Harness PreCompact checkpoint"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" bash \"$project_root/.claude/hooks/post-compact.sh\"",
            "timeout": 60,
            "statusMessage": "Harness PostCompact validation"
          }
        ]
      }
    ]
  }
}
