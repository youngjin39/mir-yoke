# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~

# Local-only Claude Code overrides (keep settings.json checked in,
# settings.local.json out — that is where personal hook overrides live)
.claude/settings.local.json

# Local Codex auth (keys stay outside the repo)
.codex/auth.json
.codex/credentials.json

# Local TDD ledger backups (keep tasks/tdd.json checked in)
tasks/tdd.json.bak
tasks/tdd.json.tmp

# Hook output / logs
.harness/logs/
*.log

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node
node_modules/

# Rust
target/

# Compiled outputs
dist/
build/
out/

# Mir memory database (created by `mir migrate up` — never commit live DB)
.mir/*.db
.mir/*.db-shm
.mir/*.db-wal

# Machine-local bootstrap evidence. The capability lock remains tracked.
.mir/bootstrap-receipt.json
.mir/slim-quarantine/
.mir/slim-transaction.json
.mir/slim.lock
.mir/runtime/

# Operator-specific profile — created by setup.sh, filled in by repo owner
.mir/repo-profile.toml
