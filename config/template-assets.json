{
  "$schema": "./template-assets.schema.json",
  "schema_version": 1,
  "classifications": [
    "starter",
    "reference",
    "optional-consumer-tool",
    "template-maintainer-tool",
    "historical"
  ],
  "rules": [
    {
      "id": "minimal-starter",
      "classification": "starter",
      "include": ["starter/**"],
      "exclude": [],
      "reason": "The only supported consumer payload: a small agent-adapted documentation baseline."
    },
    {
      "id": "root-metadata",
      "classification": "reference",
      "include": [
        "ARCHITECTURE.md",
        "BOOTSTRAP.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "MIGRATION.md",
        "README.md",
        "VERSION",
        "llms.txt"
      ],
      "exclude": [],
      "reason": "Public identity, usage, rights, compatibility, and release reference material."
    },
    {
      "id": "project-agent-kit-recipe",
      "classification": "reference",
      "include": ["recipes/**"],
      "exclude": [],
      "reason": "Supported agent-guided procedure read as reference by the target agent and never copied as a consumer payload."
    },
    {
      "id": "common-harness-template",
      "classification": "optional-consumer-tool",
      "include": ["templates/common-harness/**"],
      "exclude": [],
      "reason": "Bounded Project Agent Kit sources explicitly adapted into a consumer-owned target without copying the Mir runtime."
    },
    {
      "id": "advanced-composition-reference",
      "classification": "reference",
      "include": ["reference-templates/**"],
      "exclude": [],
      "reason": "Inactive ADR-82 composition source preserved at original relative paths for selective inspection and adaptation."
    },
    {
      "id": "legacy-bootstrap-payload",
      "classification": "reference",
      "include": [
        ".ai-harness/**",
        ".claude/**",
        ".codex/**",
        ".codex-sync/**",
        ".gitignore",
        ".mcp.json.example",
        ".mir/**",
        ".mir-preserve.toml",
        "AGENTS.md",
        "CLAUDE.md",
        "app/**",
        "config/adopter-boundary.json",
        "config/adopter-boundary.schema.json",
        "config/adopter-payload.json",
        "config/adopter-payload.schema.json",
        "config/capability-sources.json",
        "config/cli-runtime-constraints.txt",
        "config/doc-size-guard.json",
        "config/repo-agent-management.json",
        "config/repo-agent-management.schema.json",
        "config/sub-agent-policy.json",
        "docs/memory-map.md",
        "global-rules/**",
        "harness_a.toml.example",
        "lib/**",
        "setup.ps1",
        "setup.sh",
        "template_protected_paths.yaml"
      ],
      "exclude": [
        ".claude/agents/template-sync-validator.md",
        ".codex/agents/template-sync-validator.toml"
      ],
      "reason": "Legacy automated adopter payload retained as optional reference and maintainer regression material outside ADR-81 supported scope."
    },
    {
      "id": "public-references",
      "classification": "reference",
      "include": [
        "docs/architecture/**",
        "docs/bluebricks/**",
        "docs/history/**",
        "docs/operations/**",
        "docs/patterns/**",
        "docs/references/**",
        "docs/templates/**",
        "examples/**",
        "config/bluebrick-paths.json",
        "config/repos/**",
        "spec/**",
        "tasks/**"
      ],
      "exclude": [],
      "reason": "Selectable public patterns and explanations that do not apply themselves."
    },
    {
      "id": "current-decisions",
      "classification": "reference",
      "include": [
        "docs/decisions/INDEX.md",
        "docs/decisions/adr-69-codex-exec-ban-mcp-only.md",
        "docs/decisions/adr-72-dispatch-resilience.md",
        "docs/decisions/adr-73-proportional-guidance-first-harness.md",
        "docs/decisions/adr-74-portable-bootstrap-capability-sources-and-memory.md",
        "docs/decisions/adr-75-global-plugin-migration-gate.md",
        "docs/decisions/adr-76-codex-required-plugin-activation.md",
        "docs/decisions/adr-77-existing-repository-bootstrap-adoption.md",
        "docs/decisions/adr-78-public-template-identity-and-non-authority.md",
        "docs/decisions/adr-79-agent-guided-platform-scope.md",
        "docs/decisions/adr-80-release-runtime-isolation-and-adopter-ownership.md",
        "docs/decisions/adr-81-minimal-starter-support-boundary.md",
        "docs/decisions/adr-85-global-policy-inheritance-and-agent-contracts.md",
        "docs/decisions/adr-86-mir-harness-managed-repository-maintenance.md",
        "docs/decisions/adr-84-harness-upgrade-guidance-and-runtime-hygiene.md",
        "docs/decisions/adr-83-project-agent-kit-recipe-and-supported-surfaces.md",
        "docs/decisions/role-policy.md"
      ],
      "exclude": [],
      "reason": "The current product, adoption, capability, and consumer execution authority set."
    },
    {
      "id": "historical-decisions",
      "classification": "historical",
      "include": ["docs/decisions/**"],
      "exclude": [
        "docs/decisions/INDEX.md",
        "docs/decisions/adr-69-codex-exec-ban-mcp-only.md",
        "docs/decisions/adr-72-dispatch-resilience.md",
        "docs/decisions/adr-73-proportional-guidance-first-harness.md",
        "docs/decisions/adr-74-portable-bootstrap-capability-sources-and-memory.md",
        "docs/decisions/adr-75-global-plugin-migration-gate.md",
        "docs/decisions/adr-76-codex-required-plugin-activation.md",
        "docs/decisions/adr-77-existing-repository-bootstrap-adoption.md",
        "docs/decisions/adr-78-public-template-identity-and-non-authority.md",
        "docs/decisions/adr-79-agent-guided-platform-scope.md",
        "docs/decisions/adr-80-release-runtime-isolation-and-adopter-ownership.md",
        "docs/decisions/adr-81-minimal-starter-support-boundary.md",
        "docs/decisions/adr-85-global-policy-inheritance-and-agent-contracts.md",
        "docs/decisions/adr-86-mir-harness-managed-repository-maintenance.md",
        "docs/decisions/adr-84-harness-upgrade-guidance-and-runtime-hygiene.md",
        "docs/decisions/adr-83-project-agent-kit-recipe-and-supported-surfaces.md",
        "docs/decisions/role-policy.md"
      ],
      "reason": "Earlier decisions remain retrievable but are outside the current authority index."
    },
    {
      "id": "historical-engineering",
      "classification": "historical",
      "include": ["docs/governance/**", "docs/harness-engineering/**"],
      "exclude": [],
      "reason": "Centralization-era engineering and governance prose retained for audit only."
    },
    {
      "id": "portable-plugin-provider",
      "classification": "optional-consumer-tool",
      "include": [
        ".agents/plugins/**",
        ".claude-plugin/**",
        "plugins/**"
      ],
      "exclude": [],
      "reason": "Explicitly installed, namespaced host capabilities and their marketplace metadata; none belong to a target payload."
    },
    {
      "id": "optional-public-mir-cli",
      "classification": "optional-consumer-tool",
      "include": [
        "src/**",
        "tools/agent_loader/**",
        "tools/autonomous_loop/**",
        "tools/catalog_loader.py",
        "tools/hooks/**",
        "tools/mir_executor/**",
        "tools/plan_archive/**",
        "tools/run_orchestrator/**"
      ],
      "exclude": [],
      "reason": "Supported installed v0.8-compatible Mir operator CLI and wheel-bundled runtime resources; never copied into a target payload."
    },
    {
      "id": "project-agent-kit-release-evidence",
      "classification": "template-maintainer-tool",
      "include": ["release-evidence/project-agent-kit/**"],
      "exclude": [],
      "reason": "Concrete rendered prompt fixture and runtime-produced clean-room release evidence for the supported Project Agent Kit claim."
    },
    {
      "id": "retained-platform-corpus",
      "classification": "reference",
      "include": [
        "scripts/**",
        "tools/**"
      ],
      "exclude": [
        "scripts/extract_changelog_entry.py",
        "scripts/observe_project_agent_kit.py",
        "scripts/verify_plugin_cli_activation.py",
        "scripts/verify_project_agent_kit_evidence.py",
        "scripts/verify_release_readiness.py",
        "tools/agent_loader/**",
        "tools/autonomous_loop/**",
        "tools/catalog_loader.py",
        "tools/harness_consistency/**",
        "tools/hooks/**",
        "tools/mir_executor/**",
        "tools/plan_archive/**",
        "tools/run_orchestrator/**",
        "tools/template_assets.py"
      ],
      "reason": "Retained non-package scripts and tooling used as inspectable prior art without consumer compatibility."
    },
    {
      "id": "maintainer-tools",
      "classification": "template-maintainer-tool",
      "include": [
        ".github/**",
        ".claude/agents/template-sync-validator.md",
        ".codex/agents/template-sync-validator.toml",
        "config/harness-consistency.json",
        "config/harness-consistency.schema.json",
        "config/project-hooks.json",
        "config/template-assets.json",
        "config/template-assets.schema.json",
        "pyproject.toml",
        "scripts/extract_changelog_entry.py",
        "scripts/observe_project_agent_kit.py",
        "scripts/verify_plugin_cli_activation.py",
        "scripts/verify_project_agent_kit_evidence.py",
        "scripts/verify_release_readiness.py",
        "tests/**",
        "tools/harness_consistency/**",
        "tools/template_assets.py",
        "uv.lock"
      ],
      "exclude": [],
      "reason": "Files used to validate, test, package, and release Mir Yoke itself."
    }
  ],
  "prohibited_active_paths": [
    ".github/workflows/daily_health.yml",
    ".mir/harness-config.json",
    ".mir/specialists.json",
    "config/parity-classes.json",
    "config/parity-manifest.json",
    "config/parity-manifest.schema.json",
    "scripts/cron/**",
    "scripts/notify_discord.py",
    "scripts/verify_self_stop.py",
    "scripts/verify_template_applied_state.py",
    "tools/harness_consistency/parity.py",
    "tools/profile_compiler/**",
    "tools/stall_watchdog/**"
  ]
}
