{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir-yoke/config/adopter-boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_owners",
    "provider_markers",
    "provider_text_markers",
    "ephemeral_globs",
    "source_asset_manifest",
    "payload_manifest",
    "remove_classifications"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "provider_owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "repository_types"],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "repository_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "provider_markers": {"$ref": "#/$defs/paths"},
    "provider_text_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contains"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "contains": {"type": "string", "minLength": 1}
        }
      }
    },
    "ephemeral_globs": {"$ref": "#/$defs/paths"},
    "source_asset_manifest": {"type": "string", "minLength": 1},
    "payload_manifest": {"type": "string", "minLength": 1},
    "remove_classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "reference",
          "optional-consumer-tool",
          "template-maintainer-tool",
          "historical"
        ]
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
