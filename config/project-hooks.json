{
  "schema_version": 1,
  "codex_notes": [
    "GENERATED FILE: edit config/project-hooks.json and run scripts/generate_codex_derivatives.sh.",
    "Claude-only events omitted here: SessionEnd, UserPromptSubmit, StopFailure."
  ],
  "events": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "runtimes": ["claude", "codex"],
        "hooks": [
          {
            "script": ".claude/hooks/pre-tool-use.sh",
            "timeout": 30,
            "statusMessage": "Harness L2 PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "runtimes": ["claude", "codex"],
        "hooks": [
          {
            "script": ".claude/hooks/post-edit-check.sh",
            "timeout": 30,
            "statusMessage": "Harness post-edit check"
          },
          {
            "script": ".claude/hooks/post-edit-self-ingest.sh",
            "timeout": 30,
            "statusMessage": "ADR-05 self-ingest"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "runtimes": ["claude", "codex"],
        "hooks": [
          {
            "script": ".claude/hooks/pre-tool-use.sh",
            "timeout": 30,
            "statusMessage": "Harness L2 PermissionRequest"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "runtimes": ["claude", "codex"],
        "hooks": [
          {
            "script": ".claude/hooks/session-start.sh",
            "timeout": 30,
            "statusMessage": "Harness session-start"
          }
        ]
      },
      {
        "matcher": "^compact$",
        "runtimes": ["claude", "codex"],
        "hooks": [
          {
            "script": ".claude/hooks/compact-resume.sh",
            "timeout": 30,
            "statusMessage": "Harness compact resume context"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "runtimes": ["claude"],
        "hooks": [
          {
            "script": ".claude/hooks/session-end.sh",
            "timeout": 60,
            "statusMessage": "Harness canonical closeout"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "runtimes": ["claude"],
        "hooks": [
          {
            "script": ".claude/hooks/user-prompt-submit.sh",
            "timeout": 30,
            "statusMessage": "Harness context-pull directive"
          }
        ]
      }
    ],
    "Stop": [
      {
        "runtimes": ["claude", "codex"],
        "hooks": [
          {
            "script": ".claude/hooks/mir-stop.sh",
            "timeout": 30,
            "statusMessage": "Harness Stop audit"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "runtimes": ["claude"],
        "hooks": [
          {
            "script": ".claude/hooks/stop-failure-audit.sh",
            "timeout": 30,
            "statusMessage": "Harness StopFailure audit"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "runtimes": ["claude", "codex"],
        "hooks": [
          {
            "script": ".claude/hooks/pre-compact.sh",
            "timeout": 60,
            "statusMessage": "Harness PreCompact checkpoint"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "runtimes": ["claude", "codex"],
        "hooks": [
          {
            "script": ".claude/hooks/post-compact.sh",
            "timeout": 60,
            "statusMessage": "Harness PostCompact validation"
          }
        ]
      }
    ]
  }
}
