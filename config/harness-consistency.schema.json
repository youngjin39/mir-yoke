{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mir/config/harness-consistency",
  "$comment": "Repository-local manifest for verify_harness_consistency. The repo section is generated from one explicitly selected profile. Variable rule inputs stay data-driven; the verifier never discovers or manages other repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "repo",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "_generated": {
      "type": "object"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "repository_type",
        "enforcement"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "description": "Repository slug (matches config/repos/<slug>.json)."
        },
        "repository_type": {
          "type": "string",
          "description": "From the repo profile (meta_harness, code_app, hybrid_pipeline, ...)."
        },
        "role": {
          "type": "string",
          "description": "control_plane | code_tdd_review_plane | ..."
        },
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-characteristic enforcement posture. The D2 commit gate reads tools_commit_gate from here (ADR-51 D2 refine), replacing the binary catalog signal.",
          "required": [
            "tools_commit_gate",
            "tools_tdd_ledger"
          ],
          "properties": {
            "tools_commit_gate": {
              "enum": [
                "deferred",
                "lint_test",
                "lint_test_ledger"
              ],
              "description": "Repository-local tools gate: deferred, lint and test, or lint/test plus ledger."
            },
            "tools_tdd_ledger": {
              "enum": [
                "keyed_composite",
                "changes_array",
                "none"
              ],
              "description": "How tools/ TDD obligation is satisfied for this repo."
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "severity",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "ERROR",
              "WARN",
              "INFO"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "drift_class": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      }
    },
    "rule_inputs": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-rule variable inputs. Keyed by rule name. Verifier code stays generic; only this data changes as the harness evolves."
    }
  }
}
