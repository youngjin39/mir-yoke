  "policy": {
    "_generated_": "Generated from Mir Harness config/model-routing/central.toml; do not edit",
    "codex_main": {
      "model": "gpt-6.1-sol",
      "reasoning_effort": "medium",
      "tier": "main"
    },
    "custom_agent_pins": {
      "allowed": []
    },
    "delegation": {
      "_comment_": "Provider-neutral Main/Sub contract. `mode` is the only switch a reader changes; no code hardcodes a sub-agent backend. Consumed by the Main agent of either CLI and projected into the global instruction files.",
      "acceptance_evidence": {
        "rejected": [
          "self-report narrative",
          "status JSON unbacked by artifacts"
        ],
        "required": [
          "filesystem state",
          "git diff",
          "test command output"
        ],
        "rule": "The Main reads or re-runs the evidence itself. A sub agent's own claim of success is never acceptance."
      },
      "default_backend": "codex",
      "main_agent": {
        "avoids": [
          "reading whole files when a delegated summary plus verification result suffices",
          "running the execution loop itself when a sub agent can"
        ],
        "owns": [
          "user intent",
          "design",
          "orchestration",
          "context budget",
          "delegation",
          "result adjudication"
        ]
      },
      "mode": "user_command_priority",
      "modes": {
        "force_codex": "Every delegated execution step goes to Codex. A different backend requires an explicit user override recorded in the session.",
        "per_project": "The project declaration decides. A project without one falls back to default_backend.",
        "unrestricted": "Any available sub-agent backend may be used; the Main picks per task.",
        "user_command_priority": "An explicit user instruction in the session decides; absent one, the project declaration decides; absent that, default_backend."
      },
      "project_declaration": {
        "fields": [
          "delegated_execution_contract",
          "delegation_required_tasks",
          "delegation_recommended_tasks",
          "main_direct_tasks"
        ],
        "path": ".mir/repo-profile.toml",
        "section": "execution"
      },
      "resolution_order": [
        "user_command",
        "project_declaration",
        "default_backend"
      ],
      "sub_agent": {
        "owns": [
          "file edits",
          "tests",
          "verification",
          "review",
          "iteration"
        ]
      }
    },
    "harness_source": "config/model-routing/central.toml",
