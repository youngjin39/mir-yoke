# harness_a.toml.example — Engine + Worker configuration scaffold.
# `mir bootstrap` creates the active harness_a.toml when it is absent. This
# file documents the portable contract for an intentional manual setup.
#
# Required topology: one per-repository SQLite + FTS5 DB. Tracked Markdown
# archives can be re-indexed on another machine. A shared embedding endpoint is
# optional; a shared/network Mir DB or vector service is not currently supported.

[memory]
enabled = true
required = true
backend = "sqlite_fts5"
db_path = ".mir/memory.db"
vector_mode = "off"
plugin_mode = "disabled"
recall_policy = "progressive"

[memory.embedding]
enabled = false
required = false
# OPTIONAL vector-search backend. Without it the engine runs FTS5 keyword-only
# (fully functional). Chunks indexed without vectors are NOT auto-backfilled.
# After explicitly enabling this backend, use
# `mir context sync --reindex-missing-vectors` to fill missing vectors only.
# The agent must ASK before installing any server or model (BOOTSTRAP.md Step 2 f).
# Any OpenAI-compatible /v1/embeddings server works ("omlx_http" is historical).
# The model below is a recommendation. The current public vector table accepts
# 1024-dimensional, L2-normalized output only; another `dim` fails before indexing.
# Never reuse a vector DB produced by a different runtime/quantization — the
# same model name under a different runtime is a different encoder fingerprint.
#
# macOS (Apple Silicon), recommended — oMLX:
# backend = "omlx_http"
# base_url = "http://127.0.0.1:8001/v1"
# model = "bge-m3-mlx-fp16"
# fingerprint = "bge-m3@revision|omlx|fp16|1024|l2|pooling=provider|instructions=none"
# dim = 1024
# timeout_sec = 10
#
# Windows / Linux, recommended — Ollama (`ollama pull bge-m3`):
# backend = "omlx_http"
# base_url = "http://127.0.0.1:11434/v1"
# model = "bge-m3"
# dim = 1024
# timeout_sec = 10

# External archives are indexed doc trees that `mir context sync` will scan and
# make available to `mir context pull`. Add one block per archive.

[[memory.external_archives]]
slug = "your-harness-docs"
root = "docs"
mode = "indexed"
glob_include = ["**/*.md"]
# Repository-logical paths that are historical even if their frontmatter is active.
historical_glob = ["docs/history/**"]

[[memory.external_archives]]
slug = "your-harness-tasks"
root = "tasks"
mode = "indexed"
glob_include = ["**/*.md"]

[[memory.external_archives]]
slug = "your-harness-rules"
root = ".ai-harness"
mode = "indexed"
glob_include = ["**/*.md"]
